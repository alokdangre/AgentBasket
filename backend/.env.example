APP_ENV=development
DATABASE_URL=postgresql+psycopg://agentbasket:agentbasket@localhost:5432/agentbasket
SQL_ECHO=false
CHECKOUT_TTL_MINUTES=10
AUTH_SESSION_TTL_DAYS=30

# Development seed only. Use a unique 12+ character password and a secret manager in production.
MERCHANT_ADMIN_EMAIL=owner@emberandleaf.local
MERCHANT_ADMIN_PASSWORD=replace-with-a-long-local-password
MERCHANT_ADMIN_NAME=Ember & Leaf Owner

# Optional non-production shopper seeded with three addresses: two serviceable and one failure case.
DEMO_CUSTOMER_EMAIL=customer@emberandleaf.local
DEMO_CUSTOMER_PASSWORD=replace-with-a-long-local-password
DEMO_CUSTOMER_NAME=Aarav Mehta
DEMO_CUSTOMER_PHONE=+919876543210

# Razorpay test-mode credentials. Never expose the key secret or webhook secret to the browser.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-different-webhook-secret
RAZORPAY_API_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_SECONDS=8

# LangGraph uses this Gemini key only on the backend. Never expose it to Next.js.
GOOGLE_API_KEY=replace-with-google-ai-studio-key
AGENT_MODEL=gemini-3.5-flash-lite
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_HISTORY_MESSAGES=20
AGENT_MAX_OUTPUT_CHARACTERS=6000

# Optional LangSmith tracing. Create the key at https://smith.langchain.com/settings.
# Inputs/outputs stay hidden by default because turns can contain customer and order data.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentbasket-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# AP2 v0.2 human-present test issuers. Use separate ES256 P-256 keys and encode PEM
# newlines as \n in one-line environment values. No unsigned fallback exists.
AP2_AUDIENCE=agentbasket-commerce
AP2_CHALLENGE_TTL_SECONDS=300
AP2_MERCHANT_ISSUER=urn:agentbasket:merchant:ember-and-leaf
AP2_MERCHANT_KEY_ID=ember-merchant-test-1
AP2_MERCHANT_PRIVATE_KEY_PEM=
AP2_AGENT_PROVIDER_ISSUER=urn:agentbasket:agent-provider:test
AP2_AGENT_PROVIDER_KEY_ID=agentbasket-agent-provider-test-1
AP2_AGENT_PROVIDER_PRIVATE_KEY_PEM=
# Existing local setups using AP2_TRUSTED_SURFACE_* remain accepted as a fallback.
AP2_CREDENTIALS_PROVIDER_ISSUER=urn:agentbasket:credentials-provider:test
AP2_CREDENTIALS_PROVIDER_KEY_ID=agentbasket-cp-test-1
AP2_CREDENTIALS_PROVIDER_PRIVATE_KEY_PEM=
AP2_PAYMENT_PROCESSOR_ISSUER=urn:agentbasket:payment-processor:razorpay-test
AP2_PAYMENT_PROCESSOR_KEY_ID=agentbasket-processor-test-1
AP2_PAYMENT_PROCESSOR_PRIVATE_KEY_PEM=

# Trusted Surface passkeys. localhost is a secure-context exception for local testing.
# In deployment, use the exact HTTPS frontend origin and its registrable RP domain.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=AgentBasket
WEBAUTHN_EXPECTED_ORIGIN=http://localhost:3000
WEBAUTHN_CHALLENGE_TTL_SECONDS=300
