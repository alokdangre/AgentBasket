APP_ENV=development
DATABASE_URL=postgresql+psycopg://agentbasket:agentbasket@localhost:5432/agentbasket
SQL_ECHO=false
CHECKOUT_TTL_MINUTES=10
AUTH_SESSION_TTL_DAYS=30

# Development seed only. Use a unique 12+ character password and a secret manager in production.
MERCHANT_ADMIN_EMAIL=owner@emberandleaf.local
MERCHANT_ADMIN_PASSWORD=replace-with-a-long-local-password
MERCHANT_ADMIN_NAME=Ember & Leaf Owner

# Razorpay test-mode credentials. Never expose the key secret or webhook secret to the browser.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-different-webhook-secret
RAZORPAY_API_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_SECONDS=8

# Google ADK uses this Gemini key only on the backend. Never expose it to Next.js.
GOOGLE_API_KEY=replace-with-google-ai-studio-key
AGENT_MODEL=gemini-flash-latest
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_HISTORY_MESSAGES=20
AGENT_MAX_OUTPUT_CHARACTERS=6000
